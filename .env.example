# Secrets for tevind_deploy. Copy to .env (gitignored). Do NOT commit real values.
# Non-secret settings (image, versions, ports, sites, apps) live in tevind_deploy.yaml.

# Database + site admin credentials
DB_ROOT_PASSWORD=change-me
SITE_ADMIN_PASSWORD=change-me

# Host known_hosts used as a build secret when cloning private repos over SSH.
# Populate with: ssh-keyscan github.com >> ~/.ssh/known_hosts
BUILD_KNOWN_HOSTS_PATH=~/.ssh/known_hosts

# Nginx Proxy Manager admin login (used by `proxy apply` via the NPM REST API).
# Change the NPM default admin (admin@example.com / changeme) on first UI login,
# then put the new credentials here.
NPM_ADMIN_EMAIL=admin@tevind.com
NPM_ADMIN_PASSWORD=change-me

# OVH API credentials (used by `dns apply` / `dns verify`).
# Create at https://api.ovh.com/createToken/ with GET/POST/PUT/DELETE on /domain/*
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=change-me
OVH_APPLICATION_SECRET=change-me
OVH_CONSUMER_KEY=change-me
